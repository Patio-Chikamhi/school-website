rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getStudentId() {
      return getUserData().studentId || getUserData().studentDocumentId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'admin';
    }
    
    function isTeacher() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'student';
    }
    
    function isParent() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'parent';
    }
    
    function isEnrolledInCourse(courseId) {
      let studentId = getStudentId();
      return exists(/databases/$(database)/documents/enrollments/$(courseId + '_' + studentId));
    }
    
    // Public read access for announcements, events, gallery, posts
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isTeacher() ||
        (isParent() && resource.data.parentUserId == request.auth.uid)
      );
      allow create: if true; // For signup
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Students collection (kept for backward compatibility)
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() ||
        (isStudent() && getStudentId() == studentId) ||
        (isParent() && resource.data.parentUserId == request.auth.uid)
      );
      allow write: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ================= STUDENT DASHBOARD SPECIFIC RULES =================
    
    // Enrollments collection
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    // Course Materials (Resources)
    match /courseMaterials/{materialId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && isEnrolledInCourse(resource.data.courseId)) ||
        (isParent() && isEnrolledInCourse(resource.data.courseId))
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // Submissions collection (for assignment submissions)
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow create: if isStudent() && 
                     request.resource.data.studentId == getStudentId() &&
                     request.resource.data.submittedAt == request.time;
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // Grades
    match /grades/{gradeId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // Notifications (Real-time alerts)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow delete: if isAdmin() || isTeacher();
    }
    
    // ================= EXISTING RULES (UPDATED) =================
    
    // School Leaders
    match /schoolLeaders/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create: if request.auth.uid == teacherId;
      allow update: if isAdmin() || request.auth.uid == teacherId;
      allow delete: if isAdmin();
    }
    
    // Applications
    match /applications/{applicationId} {
      allow create: if true;
      allow read: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // Newsletters
    match /newsletters/{document} {
      allow read: if true;
      allow update: if 
        (request.resource.data.views == resource.data.views + 1 &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"])) ||
        isAdmin() || isTeacher();
      allow create: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // Contact messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // ================= NEW COLLECTIONS =================
    
    // Push Subscriptions (for browser notifications)
    match /pushSubscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                     request.auth.uid == resource.data.userId;
      allow delete: if isAuthenticated() && 
                     request.auth.uid == resource.data.userId;
    }
    
    // Download Logs (track file downloads)
    match /downloadLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Parent-Student Relationships
    match /parentStudentRelations/{relationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        request.auth.uid == resource.data.parentId ||
        (isStudent() && resource.data.studentId == getStudentId())
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Analytics/Usage Data
    match /analytics/{analyticId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Messages/Chat (if implemented)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                     request.auth.uid == resource.data.senderId;
      allow delete: if isAdmin();
    }
    
    // Calendar Events (personal/school)
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == getStudentId()) ||
        (isParent() && resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy ||
        isAdmin() ||
        isTeacher()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy ||
        isAdmin() ||
        isTeacher()
      );
    }
  }
}