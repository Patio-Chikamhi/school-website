rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return getUserData().role;
    }
    
    function getStudentId() {
      return getUserData().studentId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'admin';
    }
    
    function isTeacher() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'student';
    }
    
    function isParent() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserRole() == 'parent';
    }
    
    // ============================================
    // PUBLIC CONTENT — Anyone can READ
    // ============================================
    
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    match /schoolLeaders/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /newsletters/{document} {
      allow read: if true;
      allow create: if isAdmin() || isTeacher();
      allow update: if 
        (request.resource.data.views == resource.data.views + 1 &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"])) ||
        isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    match /applications/{applicationId} {
      allow create: if true;
      allow read: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    
    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isTeacher()
      );
      allow create: if true;  // Signup
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // STUDENTS — Private, allow student self-read
    // ============================================
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() ||
        getStudentId() == studentId
      );
      allow write: if isAdmin() || isTeacher();
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // TEACHERS
    // ============================================
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create: if request.auth.uid == teacherId;
      allow update: if isAdmin() || request.auth.uid == teacherId;
      allow delete: if isAdmin();
    }
    
    // ============================================
    // ENROLLMENTS
    // ============================================
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // ASSIGNMENTS
    // ============================================
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // ============================================
    // SUBMISSIONS — Students create, teachers grade
    // ============================================
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() ||
        getStudentId() == resource.data.studentId
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // GRADES — Restricted
    // ============================================
    match /grades/{gradeId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() ||
        getStudentId() == resource.data.studentId
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // ============================================
    // ATTENDANCE — Restricted
    // ============================================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() ||
        getStudentId() == resource.data.studentId
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }
    
    // ============================================
    // TERM REPORTS — Teachers create, students read own
    // ============================================
    match /termReports/{reportId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() ||
        getStudentId() == resource.data.studentId
      );
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // OTHER AUTHENTICATED COLLECTIONS
    // ============================================
    match /courseMaterials/{materialId} {
      allow read, write: if isAuthenticated();
    }
    
    match /calendarEvents/{eventId} {
      allow read, write: if isAuthenticated();
    }
    
    match /idCounters/{counterId} {
      allow read, write: if isAuthenticated();
    }
    
    match /pushSubscriptions/{subscriptionId} {
      allow read, write: if isAuthenticated();
    }
    
    match /downloadLogs/{logId} {
      allow read, write: if isAuthenticated();
    }
    
    match /parentStudentRelations/{relationId} {
      allow read, write: if isAuthenticated();
    }
    
    match /analytics/{analyticId} {
      allow read, write: if isAuthenticated();
    }
    
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // CATCH-ALL — deny by default
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}